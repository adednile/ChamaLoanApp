<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================================================= -->
        <!-- 1. APP HEADER & BRANDING (Chama Trust & Gold)            -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chama Gold &amp; Trust"
                    android:textColor="@color/brand_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automated Ledger &amp; Loan Scoring Platform"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveChamaTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_approved"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Mwangaza Chama"
                android:textColor="@color/status_approved"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- 2. ROLE SWITCHER (Human-Centered Design Principle)        -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_white"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTabMember"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:text="👤 Member Self-Service"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTabTreasurer"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_unselected"
                android:text="💼 Treasurer Console"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- SECTION A: MEMBER SELF-SERVICE PORTAL                     -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/layoutMemberPortal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Personal Financial Snapshot Card (Figure 4.10 / 5.4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Member One (Active)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Here is your personal savings &amp; credit status for July 2026."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- 2x2 Metric Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Savings Balance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Savings"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvSnapshotSavings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 40,000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>

                    <!-- Borrowing Limit (3x Multiplier) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Borrowing Limit (3x)"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvSnapshotLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 120,000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_approved" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Outstanding Loans -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Loan Balance"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0.00"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Unpaid Fines -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unpaid Fines"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0.00 (All Clear)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_approved" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Loan Application Form Card (Figure 4.12 / 5.8) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apply for a Loan (Credit Facility)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credit score and repayment terms are calculated objectively."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <!-- Requested Loan Principal -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested Loan Principal Amount (KES)*"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etLoanAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 100000 (Min 5,000, Max based on 3x savings)"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Repayment Period -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repayment Period (Months)*"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etLoanTerm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 12 or 24 months"
                    android:inputType="number"
                    android:text="12"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Primary Monthly Income -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary Monthly Income (KES)*"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/etApplicantIncome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 35000"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Member Savings Balance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verified Chama Savings Balance (KES)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <EditText
                    android:id="@+id/etMemberSavings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 40000 (Enforces 3x savings rule)"
                    android:inputType="numberDecimal"
                    android:text="40000"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Co-applicant / Guarantor Income -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Co-applicant / Guarantor Monthly Income (KES)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <EditText
                    android:id="@+id/etCoapplicantIncome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="0 if self-guaranteed"
                    android:inputType="numberDecimal"
                    android:text="0"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <!-- Past Repayment Standing -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Past Repayment Record (Chama Ledger Integrity)*"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/rgCreditHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <RadioButton
                        android:id="@+id/rbCreditClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean Record (1.0)"
                        android:checked="true"
                        android:layout_marginEnd="16dp" />
                    <RadioButton
                        android:id="@+id/rbCreditDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prior Delinquency (0.0)" />
                </RadioGroup>

                <!-- Property / Locus Area (EDA Observation 3) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chama Branch / Property Location"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/rgPropertyArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <RadioButton
                        android:id="@+id/rbAreaSemiurban"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semiurban (High Repay)"
                        android:checked="true"
                        android:layout_marginEnd="12dp" />
                    <RadioButton
                        android:id="@+id/rbAreaUrban"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urban"
                        android:layout_marginEnd="12dp" />
                    <RadioButton
                        android:id="@+id/rbAreaRural"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rural" />
                </RadioGroup>

                <!-- Action Button -->
                <Button
                    android:id="@+id/btnCheckEligibility"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/brand_primary"
                    android:text="Check Eligibility &amp; Repayment Preview"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===================================================== -->
            <!-- LIVE UNDERWRITING & REPAYMENT PREVIEW (Figure 4.12)   -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <!-- Header: Status Badge & Score Gauge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_approved"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp"
                            android:text="APPROVED"
                            android:textColor="@color/status_approved"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRiskTierBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low Risk Profile"
                            android:textColor="@color/status_approved"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Circular Score Indicator (Figure 4.12: 7.4 / 10) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:background="@drawable/bg_score_circle"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvScoreNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.2"
                            android:textColor="@color/status_approved"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="out of 10"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Probability Bar -->
                <TextView
                    android:id="@+id/tvProbabilityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model Approval Confidence: 82.0%"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/pbProbability"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="82"
                    android:progressTint="@color/status_approved"
                    android:layout_marginBottom="14dp" />

                <!-- Repayment Schedule Preview (Figure 4.12 / 5.8) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repayment Preview (10% Annual Reducing Balance)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/card_subtle"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Est. Monthly Payment"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvEstMonthlyPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 8,791.67"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Interest"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvTotalInterest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 5,500.00"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bylaw Policy Compliance Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chama Bylaws Compliance Check:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvSavingsComplianceChip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Savings Cap: Requested 100k vs Max Eligible 120k (2.5x Leverage - Compliant)"
                    android:textSize="12sp"
                    android:textColor="@color/status_approved"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvDtiComplianceChip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Monthly DTI: 25.1% of household income (Healthy &lt; 45% threshold)"
                    android:textSize="12sp"
                    android:textColor="@color/status_approved"
                    android:layout_marginTop="2dp" />

                <!-- Executive Committee Directive -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Committee Action Required:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Application satisfies all criteria. Forwarded to Treasurer for final sign-off."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- SECTION B: TREASURER ADMINISTRATIVE CONSOLE               -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/layoutTreasurerConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Group Liquidity Card (Figure 4.9 / 5.14) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chama Liquidity &amp; Portfolio Health"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time group ledger reserves and risk exposure."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Savings Pool"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 285,000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/card_subtle"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Loans Disbursed"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 150,000"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_gold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Examiner Preset Demo Bar (Human-Centered Presentation) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Defense Demonstration Presets"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to load test cases validated in RandomForest_Base.ipynb"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnPresetPrime"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_approved"
                        android:text="Prime Member"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPresetGuarantor"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_warning"
                        android:text="Guarantor Rescue"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetCapExceeded"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_primary"
                        android:text="3x Cap Exceeded"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPresetDefault"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_rejected"
                        android:text="Bad Credit Default"
                        android:textSize="11sp"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
