<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <!-- ─────────────────────────────────────────────────── -->
    <!-- APP TOOLBAR                                         -->
    <!-- ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/brand_primary"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chama Gold &amp; Trust"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolbarSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan Application"
                android:textColor="#B2FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quick overflow menu button -->
        <Button
            android:id="@+id/btnQuickMenu"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:text="⋮ Menu"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ─────────────────────────────────────────────────── -->
    <!-- FRAGMENT CONTENT AREA (fills remaining space)      -->
    <!-- ─────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ─────────────────────────────────────────────────── -->
    <!-- BOTTOM NAVIGATION BAR                              -->
    <!-- ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:weightSum="4">

        <!-- Tab: Loan Apply -->
        <LinearLayout
            android:id="@+id/navTabLoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <TextView android:id="@+id/tvNavIconLoan"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💳" android:textSize="20sp" />
            <TextView android:id="@+id/tvNavTextLoan"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loan" android:textColor="@color/brand_primary"
                android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab: My Ledger -->
        <LinearLayout
            android:id="@+id/navTabLedger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <TextView android:id="@+id/tvNavIconLedger"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📊" android:textSize="20sp" />
            <TextView android:id="@+id/tvNavTextLedger"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ledger" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab: Treasurer -->
        <LinearLayout
            android:id="@+id/navTabTreasurer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <TextView android:id="@+id/tvNavIconTreasurer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💼" android:textSize="20sp" />
            <TextView android:id="@+id/tvNavTextTreasurer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Treasurer" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab: Bylaws -->
        <LinearLayout
            android:id="@+id/navTabBylaws"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <TextView android:id="@+id/tvNavIconBylaws"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📜" android:textSize="20sp" />
            <TextView android:id="@+id/tvNavTextBylaws"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bylaws" android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
