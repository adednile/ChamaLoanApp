<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/brand_primary"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join or Create a Chama"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register as a Chama Member or Chama Treasurer"
                android:textColor="#B2FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Register Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="16dp">

            <!-- ── 1. ROLE SELECTION: MEMBER VS TREASURER ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Your Role *"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgRegisterRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <RadioButton
                    android:id="@+id/rbRoleMember"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👤 Member"
                    android:checked="true"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbRoleTreasurer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💼 Treasurer"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- ── 2. FULL LEGAL NAME ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Legal Name *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. Wanjiku Kamau"
                android:inputType="textPersonName"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field" />

            <!-- ── 3. UNIQUE EMAIL ADDRESS (No defaults!) ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Email Address *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. wanjiku@example.com"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field" />

            <!-- ── 4. PHONE NUMBER (M-PESA) ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M-Pesa Phone Number *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="07XX XXX XXX or 2547XX XXX XXX"
                android:inputType="phone"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field" />

            <!-- ── 5. NATIONAL ID NUMBER ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="National ID / Passport Number *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterNationalId"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. 36481959"
                android:inputType="number"
                android:maxLength="8"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field" />

            <!-- ── 6. CONDITIONAL TREASURER FIELD: CHAMA NAME ── -->
            <LinearLayout
                android:id="@+id/layoutTreasurerFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chama Group Name *"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etRegisterChamaName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="e.g. Umoja Women Investment Chama"
                    android:inputType="textCapWords"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_field" />
            </LinearLayout>

            <!-- ── 7. CHAMA GROUP CODE (Generated for Treasurer, Entered by Member) ── -->
            <TextView
                android:id="@+id/tvLabelGroupCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chama Group Code (from your Treasurer) *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterGroupCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. CH-4482"
                android:inputType="textCapCharacters"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_input_field" />

            <TextView
                android:id="@+id/tvGroupCodeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask your Chama Treasurer for your 6-character group code."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <!-- ── 8. SECURITY PIN ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set 4-Digit Security PIN *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterPin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textSize="20sp"
                android:letterSpacing="0.3"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm 4-Digit PIN *"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etRegisterPinConfirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textSize="20sp"
                android:letterSpacing="0.3"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_input_field" />

            <!-- Error message display -->
            <TextView
                android:id="@+id/tvRegisterError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/status_rejected"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Join Chama as Member"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/screen_background"
                android:text="← Back to Sign In"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
