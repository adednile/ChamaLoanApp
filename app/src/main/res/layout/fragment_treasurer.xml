<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Group Liquidity Portfolio ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chama Group Portfolio"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time reserve snapshot · Mwangaza Chama · November 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <!-- Row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/card_subtle"
                    android:padding="10dp" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Savings Pool" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="KES 285,000" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/brand_primary" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/card_subtle"
                    android:padding="10dp" android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Active Disbursed" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="KES 150,000" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/brand_gold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/card_subtle"
                    android:padding="10dp" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Available Liquidity" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="KES 135,000" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/status_approved" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@color/card_subtle"
                    android:padding="10dp" android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Non-Performing Loans" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0.0% — Zero Default" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/status_approved" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Active Loan Applications Table ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Loan Applications"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Header row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@color/brand_primary"
                android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Member" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Amount" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Status" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Data Row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@color/card_subtle" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="J. Mwangi" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="KES 80,000" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Reviewing" android:textColor="@color/status_warning" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Data Row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="A. Odhiambo" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="KES 60,000" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Approved" android:textColor="@color/status_approved" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Data Row 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@color/card_subtle" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="F. Kamau" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="KES 150,000" android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                    android:text="Rejected" android:textColor="@color/status_rejected" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Demo Presets ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Defense Demonstration Presets"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loads a pre-validated scenario into the Loan screen and runs the AI model."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnPresetPrime"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:backgroundTint="@color/status_approved"
                    android:text="✓  Prime Member"
                    android:textSize="11sp" android:textColor="@android:color/white"
                    android:layout_marginEnd="4dp" />
                <Button android:id="@+id/btnPresetGuarantor"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:backgroundTint="@color/status_warning"
                    android:text="⚠  Guarantor Rescue"
                    android:textSize="11sp" android:textColor="@android:color/white"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPresetCapExceeded"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:backgroundTint="@color/brand_primary"
                    android:text="⛔  3× Cap Exceeded"
                    android:textSize="11sp" android:textColor="@android:color/white"
                    android:layout_marginEnd="4dp" />
                <Button android:id="@+id/btnPresetDefault"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:backgroundTint="@color/status_rejected"
                    android:text="✗  Bad Credit Default"
                    android:textSize="11sp" android:textColor="@android:color/white"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
