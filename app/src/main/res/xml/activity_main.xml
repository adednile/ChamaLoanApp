<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chama Loan Eligibility Portal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etApplicantIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Applicant Income (KES)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etCoapplicantIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Co-applicant Income (KES)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etLoanAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requested Loan Amount (KES)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etLoanTerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Loan Term (Months, e.g., 360)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCheckEligibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Loan Eligibility"
            android:backgroundTint="@color/design_default_color_primary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prediction results will appear here."
            android:textSize="16sp"
            android:textStyle="italic"/>

    </LinearLayout>
</ScrollView>